{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyStorage Desktop",
  "version": "1.0.0",
  "identifier": "com.mystorage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyStorage Desktop",
        "width": 900,
        "height": 660,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
