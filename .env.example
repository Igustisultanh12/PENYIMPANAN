APP_NAME=MyStorage
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mystorage.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MySQL 8+ Production Ready)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mystorage
DB_USERNAME=mystorage_user
DB_PASSWORD=your_secure_db_password

# Session & Cache (Redis Backed)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=mystorage_cache

# Queue Worker (Redis High-Performance Queue)
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Storage Abstraction (local, s3, or minio)
FILESYSTEM_DISK=local

# AWS S3 / MinIO Object Storage Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your_storage_bucket
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google OAuth (Laravel Socialite)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# Email Configuration (SMTP Queued)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@mystorage.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Notification Service Provider
WHATSAPP_PROVIDER=generic
WHATSAPP_API_KEY=your_whatsapp_provider_api_key
WHATSAPP_API_ENDPOINT=https://api.whatsapp-provider.com/v1/messages

# Storage Platform Policies
DEFAULT_STORAGE_QUOTA_GB=10
CHUNK_UPLOAD_DEFAULT_SIZE_MB=5
TRASH_RETENTION_DAYS=30

VITE_APP_NAME="${APP_NAME}"
